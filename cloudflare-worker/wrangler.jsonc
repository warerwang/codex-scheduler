{
  "name": "codex-scheduler-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_REPOSITORY": "warerwang/codex-scheduler",
    "GITHUB_WORKFLOW": "codex-refresh-time.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      "50 21 * * SUN-THU",
      "5 3 * * MON-FRI"
    ]
  }
}
